<?xml version="1.0" encoding="utf-8"?>

<extension type="component" method="upgrade">

    <name>COM_LINKLISTM</name>

    <author>Speckenbach.net</author>

    <version>0.1.0</version>

    <description>COM_LINKLISTM_DESCRIPTION</description>

    <namespace path="src">SpeckenbachNet\Component\LinkListM</namespace>

    <files folder="components/com_linklistm">
		<folder>src</folder>
		<folder>tmpl</folder>
    </files>
	
	<languages folder="language">
		<language tag="de-DE">de-DE/com_linklistm.ini</language>
		<language tag="de-DE">de-DE/com_linklistm.sys.ini</language>
		<language tag="en-GB">en-GB/com_linklistm.ini</language>
		<language tag="en-GB">en-GB/com_linklistm.sys.ini</language>
	</languages>

    <administration>
	
		<menu link="option=com_linklistm">
			COM_LINKLISTM_MENU_LINKLIST
		</menu>

		<submenu>
			<menu link="option=com_linklistm&amp;view=linklists">
				COM_LINKLISTM_MENU_LINKS
			</menu>

			<menu link="option=com_categories&amp;extension=com_linklistm">
				COM_LINKLISTM_MENU_CATEGORIES
			</menu>
		</submenu>

        <files folder="administrator/components/com_linklistm">
		    <folder>language</folder>
			<folder>sql</folder>
            <folder>services</folder>		
			<folder>src</folder>
			<folder>tmpl</folder>
			<folder>forms</folder>
			<filename>access.xml</filename>
        </files>
		
		<languages folder="administrator/components/com_linklistm/language">
			<language tag="de-DE">de-DE/com_linklistm.ini</language>
			<language tag="de-DE">de-DE/com_linklistm.sys.ini</language>
			<language tag="en-GB">en-GB/com_linklistm.ini</language>
			<language tag="en-GB">en-GB/com_linklistm.sys.ini</language>
		</languages>
		
    </administration>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/linklistm.install.sql</file>
		</sql>
	</install>

</extension>