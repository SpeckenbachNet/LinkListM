<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout
        title="COM_LINKLISTM_LINKLISTS_VIEW_DEFAULT_TITLE"
        option="COM_LINKLISTM_LINKLISTS_VIEW_DEFAULT_OPTION"
    >
        <message>
            <![CDATA[COM_LINKLISTM_LINKLISTS_VIEW_DEFAULT_DESC]]>
        </message>
    </layout>

    <fields name="params">
        <fieldset name="basic">

            <field
                name="catids"
                type="category"
                label="COM_LINKLISTM_FIELD_CATEGORIES"
                description="COM_LINKLISTM_FIELD_CATEGORIES_DESC"
                extension="com_linklistm"
                multiple="true"
                layout="joomla.form.field.list-fancy-select"
                filter="intarray"
            />

            <field
                name="display_style"
                type="list"
                label="COM_LINKLISTM_FIELD_DISPLAY_STYLE"
                description="COM_LINKLISTM_FIELD_DISPLAY_STYLE_DESC"
                default="list"
            >
                <option value="list">COM_LINKLISTM_DISPLAY_STYLE_LIST</option>
                <option value="tiles">COM_LINKLISTM_DISPLAY_STYLE_TILES</option>
            </field>

            <field
                name="columns"
                type="list"
                label="COM_LINKLISTM_FIELD_COLUMNS"
                description="COM_LINKLISTM_FIELD_COLUMNS_DESC"
                default="2"
                showon="display_style:tiles"
            >
                <option value="2">2</option>
                <option value="3">3</option>
            </field>

            <field
                name="include_subcategories"
                type="radio"
                label="COM_LINKLISTM_FIELD_INCLUDE_SUBCATEGORIES"
                default="1"
                layout="joomla.form.field.radio.switcher"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="ordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                default="ordering"
            >
                <option value="ordering">JGRID_HEADING_ORDERING</option>
                <option value="title">JGLOBAL_TITLE</option>
            </field>

            <field
                name="direction"
                type="list"
                label="COM_LINKLISTM_FIELD_DIRECTION"
                default="ASC"
            >
                <option value="ASC">JGLOBAL_ORDER_ASCENDING</option>
                <option value="DESC">JGLOBAL_ORDER_DESCENDING</option>
            </field>

            <field
                name="show_description"
                type="radio"
                label="COM_LINKLISTM_FIELD_SHOW_DESCRIPTION"
                default="1"
                layout="joomla.form.field.radio.switcher"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="show_domain"
                type="radio"
                label="COM_LINKLISTM_FIELD_SHOW_DOMAIN"
                default="1"
                layout="joomla.form.field.radio.switcher"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="new_window"
                type="radio"
                label="COM_LINKLISTM_FIELD_NEW_WINDOW"
                description="COM_LINKLISTM_FIELD_NEW_WINDOW_DESC"
                default="1"
                layout="joomla.form.field.radio.switcher"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

        </fieldset>
    </fields>
</metadata>
